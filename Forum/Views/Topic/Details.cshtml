@model Forum.Models.Topic

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container mt-4">
    <nav>
        <a href="@Url.Action("Index")">Home</a> / <span>@Model.Title</span>
    </nav>

    <h2>@Model.Title</h2>
    <small class="text-muted">
        @Model.CreatedAt.ToString("dd.MM.yyyy") — Author: @Model.AuthorName
    </small>

    <article class="mt-3 p-3 border rounded">
        @Html.Raw(Model.Content.Replace("\n", "<br />"))
    </article>

    <hr />
    <h4>Replies</h4>
    <div id="replies">
        @foreach (var r in (List<Forum.Models.Reply>)ViewBag.TopicReplies)
        {
            @await Html.PartialAsync("_ReplyPartial", r)
        }
    </div>
    
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav id="repliesPagination" class="mt-3">
            <ul class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="#" data-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="mt-3">
            <textarea id="replyContent" class="form-control mb-2" rows="3" placeholder="Write a reply..."></textarea>
            <button id="btnReply" class="btn btn-primary" data-topic-id="@Model.Id">Reply</button>
        </div>
    }
</div>

@section Scripts {
    <script>
        const btn = document.getElementById("btnReply");
        btn?.addEventListener("click", async () => {
            const topicId = btn.dataset.topicId;
            const content = document.getElementById("replyContent").value;

            if (!content.trim()) return;

            const formData = new FormData();
            formData.append("topicId", topicId);
            formData.append("content", content);

            const res = await fetch("@Url.Action("PostReply")", {
                method: "POST",
                body: formData,
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });

            if (res.ok) {
                const html = await res.text();
                const repliesDiv = document.getElementById("replies");
                repliesDiv.insertAdjacentHTML("beforeend", html);
                document.getElementById("replyContent").value = "";
            } else {
                alert("Failed to post reply.");
            }
        });

        function loadRepliesPage(topicId, page) {
            fetch(`@Url.Action("Details")?id=${@Model.Id}&page=${page}`, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");
                    const newReplies = doc.getElementById("replies").innerHTML;
                    document.getElementById("replies").innerHTML = newReplies;

                    document.querySelectorAll("#repliesPagination .page-item").forEach(li => li.classList.remove("active"));
                    const newActive = document.querySelector(`#repliesPagination .page-link[data-page='${page}']`)?.parentElement;
                    newActive?.classList.add("active");
                });
        }

        document.querySelectorAll("#repliesPagination .page-link").forEach(link => {
            link.addEventListener("click", e => {
                e.preventDefault();
                const page = link.dataset.page;
                loadRepliesPage(@Model.Id, page);
            });
        });
    </script>
}