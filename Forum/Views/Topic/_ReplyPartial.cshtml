@model Forum.Models.Reply

<div class="card mb-2">
    <div class="card-body d-flex">
        <img src="@(string.IsNullOrWhiteSpace(@Model.User.AvatarPath) ? "/images/default-avatar.png" : @Model.User.AvatarPath)" 
             class="rounded-circle me-2" width="40" height="40" />
        <div>
            <strong>@Model.User.UserName</strong>
            <small class="text-muted ms-2">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            <p class="mb-0">@Model.Content</p>
        </div>
    </div>
</div>