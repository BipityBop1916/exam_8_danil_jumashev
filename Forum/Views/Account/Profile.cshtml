@model Forum.Models.AccountViewModels.ProfileViewModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Профиль пользователя</h2>

    <div class="row mt-3">
        <div class="col-md-3">
            <img src="@Model.AvatarPath" class="img-thumbnail" alt="Avatar" />
        </div>
        <div class="col-md-9">
            <dl class="row">
                <dt class="col-sm-3">Имя пользователя</dt>
                <dd class="col-sm-9">@Model.UserName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Сообщений на форуме</dt>
                <dd class="col-sm-9">@Model.PostCount</dd>
            </dl>
        </div>
    </div>
</div>